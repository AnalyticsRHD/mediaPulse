# API Configuration
API_PORT=3333
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@host:5432/postgres
DB_SSL=true
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_DROP_SCHEMA=false
DB_POOL_MAX=5
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_CONNECTION_TIMEOUT_MS=30000

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# Meta (Facebook Ads)
META_ACCESS_TOKEN=your_meta_access_token_here
META_ACCESS_TOKEN_ALLOC=your_meta_credit_alloc_access_token_here
META_ACCOUNT_ID=your_meta_account_id_here

# Google Ads
GOOGLE_ACCESS_TOKEN=your_google_access_token_here
GOOGLE_CUSTOMER_ID=your_google_customer_id_here

# Supermetrics API
SUPERMETRICS_API_BASE_URL=https://api.supermetrics.com/enterprise/v2
SUPERMETRICS_API_KEY=your_supermetrics_api_key_here
SUPERMETRICS_GOOGLE_ADS_QUERY_JSON={"ds_id":"AW","ds_accounts":"list.all_accounts","ds_user":"your_supermetrics_ds_user_here","date_range_type":"custom","max_rows":100000,"fields":[{"id":"month"},{"id":"profile"},{"id":"profileID"},{"id":"cost"},{"id":"conversionsmanyperclick"},{"id":"totalconversionvalue"}]}
SUPERMETRICS_FACEBOOK_ADS_QUERY_JSON={"ds_id":"FA","ds_accounts":"list.all_accounts","ds_user":"your_supermetrics_ds_user_here","date_range_type":"yesterday","max_rows":1000,"fields":[{"id":"profile"},{"id":"profileID"},{"id":"cost"}]}
SUPERMETRICS_LINKEDIN_ADS_QUERY_JSON={"ds_id":"LIA","ds_accounts":"list.all_accounts","ds_user":"your_supermetrics_ds_user_here","date_range_type":"custom","max_rows":100000,"fields":[{"id":"month"},{"id":"accountName"},{"id":"accountId"},{"id":"spend"},{"id":"impressions"},{"id":"clicks"},{"id":"likes"},{"id":"comments"},{"id":"shares"}]}
SUPERMETRICS_CACHE_MINUTES=60
SUPERMETRICS_SYNC_TIMEOUT_SECONDS=300

# TikTok Marketing API
TIKTOK_API_BASE_URL=https://business-api.tiktok.com/open_api/v1.3
TIKTOK_APP_ID=your_tiktok_app_id_here
TIKTOK_APP_SECRET=your_tiktok_app_secret_here
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here
TIKTOK_ADVERTISER_IDS=advertiser_id_1,advertiser_id_2
TIKTOK_SYNC_TIMEOUT_SECONDS=60

# Mercado Libre Ads
# Uses Mercado Libre API when token/advertisers are configured, and falls back to raw Google Sheets.
MERCADO_LIBRE_API_BASE_URL=https://api.mercadolibre.com
MERCADO_LIBRE_ACCESS_TOKEN=your_mercado_libre_access_token_here
MERCADO_LIBRE_REFRESH_TOKEN=your_mercado_libre_refresh_token_here
MERCADO_LIBRE_CLIENT_ID=your_mercado_libre_app_id_here
MERCADO_LIBRE_CLIENT_SECRET=your_mercado_libre_secret_key_here
MERCADO_LIBRE_OAUTH_STATE_PATH=apps/api/data/mercado-libre-oauth.json
# Optional. If empty, the API lists Product Ads advertisers with product_id=PADS.
# Format: advertiser_id or advertiser_id:account_name or advertiser_id:account_name:referencia
MERCADO_LIBRE_ADVERTISER_IDS=advertiser_id_1:DC Shoes 3P:DC Shoes 3P,advertiser_id_2:Quiksilver:Quiksilver
MERCADO_LIBRE_PRODUCTS=PADS,DSP
MERCADO_LIBRE_SYNC_TIMEOUT_SECONDS=60
