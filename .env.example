# API Configuration
API_PORT=3333
NODE_ENV=development

# Airtable
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here

# Meta (Facebook Ads)
META_ACCESS_TOKEN=your_meta_access_token_here
META_ACCOUNT_ID=your_meta_account_id_here

# Google Ads
GOOGLE_ACCESS_TOKEN=your_google_access_token_here
GOOGLE_CUSTOMER_ID=your_google_customer_id_here

# Supermetrics API
SUPERMETRICS_API_BASE_URL=https://api.supermetrics.com/enterprise/v2
SUPERMETRICS_API_KEY=your_supermetrics_api_key_here
SUPERMETRICS_GOOGLE_ADS_QUERY_JSON={"ds_id":"AW","ds_accounts":"list.all_accounts","ds_user":"your_supermetrics_ds_user_here","date_range_type":"custom","max_rows":100000,"fields":[{"id":"month"},{"id":"profile"},{"id":"profileID"},{"id":"cost"},{"id":"conversionsmanyperclick"},{"id":"totalconversionvalue"}]}
SUPERMETRICS_FACEBOOK_ADS_QUERY_JSON={"ds_id":"FA","ds_accounts":"list.all_accounts","ds_user":"your_supermetrics_ds_user_here","date_range_type":"yesterday","max_rows":1000,"fields":[{"id":"profile"},{"id":"profileID"},{"id":"cost"}]}
SUPERMETRICS_LINKEDIN_ADS_QUERY_JSON={"ds_id":"LIA","ds_accounts":"list.all_accounts","ds_user":"your_supermetrics_ds_user_here","date_range_type":"custom","max_rows":100000,"fields":[{"id":"month"},{"id":"accountName"},{"id":"accountId"},{"id":"spend"},{"id":"impressions"},{"id":"clicks"},{"id":"likes"},{"id":"comments"},{"id":"shares"}]}
SUPERMETRICS_CACHE_MINUTES=60
SUPERMETRICS_SYNC_TIMEOUT_SECONDS=300
