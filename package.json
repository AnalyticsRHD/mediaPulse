{
  "name": "mediapulse-rhd",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace @mediapulse/api run start:dev",
    "dev:web": "npm --workspace @mediapulse/web run dev",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "concurrently": "^8.2.2",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
